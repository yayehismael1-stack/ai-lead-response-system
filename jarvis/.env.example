# Copy this file to .env and fill in real values. .env is gitignored.

# ElevenLabs — required for voice in (Scribe STT) and voice out (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional — powers conversation/tool routing via Claude.
# Without this, JARVIS falls back to keyword-based routing and shows
# a "model unavailable" badge in the UI.
ANTHROPIC_API_KEY=

# 1 = demo fixtures (default, safe to screen-record). 0 = your real folders.
JARVIS_DEMO=1

# Only used when JARVIS_DEMO=0. Comma-separated, read-only.
JARVIS_VAULT_PATHS=
JARVIS_INBOX_PATH=
JARVIS_CALENDAR_PATH=
